// TeacherBox 共用资源：版本信息 + 清单（main/update/gui 三个 exe 都挂这份）
#pragma code_page(65001)
1 24 "app.manifest"
101 ICON "app.ico"

1 VERSIONINFO
 FILEVERSION     1,1,3,0
 PRODUCTVERSION  1,1,3,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          0x40004L
 FILETYPE        0x1L
 FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName",      "minifan"
            VALUE "FileDescription",  "TeacherBox 教师工具箱"
            VALUE "FileVersion",      "1.1.3.0"
            VALUE "InternalName",     "TeacherBox"
            VALUE "LegalCopyright",   "Copyright (C) 2026 minifan"
            VALUE "OriginalFilename", "TeacherBox.exe"
            VALUE "ProductName",      "TeacherBox 教师工具箱"
            VALUE "ProductVersion",   "1.1.3.0"
            VALUE "Comments",         "TeacherBox teacher toolbox by minifan"
            VALUE "Publisher",        "minifan"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
