{
  "name": "Python 运行时",
  "version": "3.12",
  "description": "脚本、成绩表、批改小工具",
  "check": { "command": "python --version", "timeout": 20 },
  "install": {
    "command": "winget install -e --id Python.Python.3.12 --accept-source-agreements --accept-package-agreements",
    "timeout": 1200
  },
  "actions": [
    { "label": "IDLE", "command": "python -m idlelib" },
    { "label": "解释器", "command": "python.exe" }
  ],
  "help": "help.md"
}
