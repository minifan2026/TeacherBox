{
  "name": "Git 备课存档",
  "version": "2.x",
  "description": "课件与教案的版本存档",
  "check": { "command": "git --version", "timeout": 20 },
  "install": {
    "command": "winget install -e --id Git.Git --accept-source-agreements --accept-package-agreements",
    "timeout": 1200
  },
  "actions": [
    { "label": "Git Bash", "command": "git-bash.exe" }
  ],
  "help": "help.md"
}
